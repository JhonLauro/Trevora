# Backend: Supabase project/API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend: Supabase Postgres connection
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

# Backend: server
PORT=

# Backend: receipt OCR + AI extraction
OCR_PROVIDER=google-vision
GOOGLE_CLOUD_VISION_API_KEY=
AI_EXTRACTION_PROVIDER=openai

# Backend: OpenAI speech-to-text, translation, and extraction
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RAW_TRANSCRIPTION_MODEL=
OPENAI_TEXT_TRANSLATION_MODEL=

# Frontend: Vite-exposed variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
VITE_SUPABASE_RECEIPT_BUCKET=
# Optional, defaults to `profile-photos` (see database/migrations/013).
VITE_SUPABASE_AVATAR_BUCKET=

# The browser app's origin. Used to build the URL inside a share QR code,
# so a phone scanning it opens the app rather than the machine that made it.
TREVORA_FRONTEND_BASE_URL=
